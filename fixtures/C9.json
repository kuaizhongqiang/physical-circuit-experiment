{
  "case": "C9",
  "baseline_source": "自建",
  "note": "反接制动：KS 速度继电器按转速释放。转速由应用传入（D-20261103-18 / D-20261103-20）。",
  "strict_reference": true,
  "config": { "v_line": 380, "freq_hz": 50 },

  "devices": [
    { "ref": "P1", "kind": "POWER", "id": 1, "terminal_base": 0, "params": [380, 50, 0.001, 1, 0, 0, 0, 0] },
    { "ref": "KM1", "kind": "KM", "id": 2, "terminal_base": 4, "aux": 5, "params": [12000, 8000, 0.02, 0.012, 0.001, 0, 0, 0] },
    { "ref": "KM2", "kind": "KM", "id": 3, "terminal_base": 16, "aux": 5, "params": [12000, 8000, 0.02, 0.012, 0.001, 0, 0, 0] },
    { "ref": "KS1", "kind": "KS", "id": 4, "terminal_base": 28, "params": [120, 100, 0.001, 0, 0, 0, 0, 0] },
    { "ref": "M1", "kind": "M", "id": 5, "terminal_base": 32, "shaft_group": 1, "params": [40, 18, 0, 0, 0, 0, 0, 0] },
    { "ref": "PE1", "kind": "PE", "id": 6, "terminal_base": 38, "params": [0, 0, 0, 0, 0, 0, 0, 0] }
  ],

  "wires": [
    { "a": 0, "b": 6, "note": "L1 → KM1.1（正转）" },
    { "a": 1, "b": 8, "note": "L2 → KM1.3" },
    { "a": 2, "b": 10, "note": "L3 → KM1.5" },
    { "a": 7, "b": 32, "note": "KM1.2 → M1.U1" },
    { "a": 9, "b": 33, "note": "KM1.4 → M1.V1" },
    { "a": 11, "b": 34, "note": "KM1.6 → M1.W1" },
    { "a": 0, "b": 22, "note": "L1 → KM2.5（反接换相）" },
    { "a": 23, "b": 32, "note": "KM2.6 → M1.U1" },
    { "a": 1, "b": 20, "note": "L2 → KM2.3" },
    { "a": 21, "b": 33, "note": "KM2.4 → M1.V1" },
    { "a": 2, "b": 18, "note": "L3 → KM2.1" },
    { "a": 19, "b": 34, "note": "KM2.2 → M1.W1" },
    { "a": 35, "b": 36, "note": "星点 U2-V2" },
    { "a": 36, "b": 37, "note": "星点 V2-W2" },
    { "a": 3, "b": 38, "note": "P1.N → PE1" },
    { "a": 0, "b": 4, "note": "L1 → KM1.A1" },
    { "a": 5, "b": 1, "note": "KM1.A2 → L2" },
    { "a": 0, "b": 28, "note": "L1 → KS1.13（正转动作触点）" },
    { "a": 29, "b": 16, "note": "KS1.14 → KM2.A1" },
    { "a": 17, "b": 1, "note": "KM2.A2 → L2" }
  ],

  "cases": [
    {
      "name": "正转运行（KM2 支路断开）：5.02 A",
      "drop_wires": [17, 18],
      "set": { "KS1": { "rpm": 1300 } },
      "expect": { "M1:0": { "i_rms": 5.0156, "tol": 0.01 } }
    },
    {
      "name": "反接制动中（rpm=1300，KS 触点闭合）：反相序仍然 5.02 A",
      "drop_wires": [15, 16],
      "set": { "KS1": { "rpm": 1300 } },
      "expect": { "M1:0": { "i_rms": 5.0156, "tol": 0.01 } }
    },
    {
      "name": "转速掉到 90 rpm：KS 释放，反接接触器失电",
      "drop_wires": [15, 16],
      "set": { "KS1": { "rpm": 90 }, "KM2": { "state_bits": 15, "flags": 0 } },
      "expect": { "M1:0": { "i_rms": 0.0, "tol_abs": 0.001 } },
      "expect_devices": { "KM2": { "coil_i_rms": 0.0, "tol_abs": 0.0001 } }
    }
  ]
}
