{
  "case": "C3",
  "baseline_source": "自建",
  "note": "两地控制（双开双控）：两组启停按钮控一台三相电动机。演示页即此电路（docs/demo.md）。",
  "strict_reference": true,
  "config": { "v_line": 380, "freq_hz": 50 },

  "devices": [
    { "ref": "P1", "kind": "POWER", "id": 1, "terminal_base": 0, "aux": 0,
      "params": [380, 50, 0.001, 1, 0, 0, 0, 0] },
    { "ref": "QS1", "kind": "QS", "id": 2, "terminal_base": 4, "aux": 3,
      "state_bits": 7, "flags": 1, "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "FU1", "kind": "FU", "id": 3, "terminal_base": 10, "aux": 0,
      "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "FU2", "kind": "FU", "id": 4, "terminal_base": 12, "aux": 0,
      "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "FU3", "kind": "FU", "id": 5, "terminal_base": 14, "aux": 0,
      "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "FR1", "kind": "FR", "id": 6, "terminal_base": 16, "aux": 0,
      "params": [0.001, 6, 5000, 0.001, 0, 0, 0, 0] },
    { "ref": "KM1", "kind": "KM", "id": 7, "terminal_base": 26, "aux": 5,
      "params": [12000, 8000, 0.02, 0.012, 0.001, 0, 0, 0] },
    { "ref": "M1", "kind": "M", "id": 8, "terminal_base": 38, "aux": 0,
      "params": [40, 18, 0, 0, 0, 0, 0, 0] },
    { "ref": "PE1", "kind": "PE", "id": 9, "terminal_base": 44, "aux": 0,
      "params": [0, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "FU4", "kind": "FU", "id": 10, "terminal_base": 45, "aux": 0,
      "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "FU5", "kind": "FU", "id": 11, "terminal_base": 47, "aux": 0,
      "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "SB1", "kind": "SB", "id": 12, "terminal_base": 49, "aux": 1,
      "state_bits": 1, "flags": 1, "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "SB2", "kind": "SB", "id": 13, "terminal_base": 53, "aux": 2,
      "state_bits": 0, "flags": 1, "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "SB3", "kind": "SB", "id": 14, "terminal_base": 57, "aux": 1,
      "state_bits": 1, "flags": 1, "params": [0.001, 0, 0, 0, 0, 0, 0, 0] },
    { "ref": "SB4", "kind": "SB", "id": 15, "terminal_base": 61, "aux": 2,
      "state_bits": 0, "flags": 1, "params": [0.001, 0, 0, 0, 0, 0, 0, 0] }
  ],

  "wires": [
    { "a": 0, "b": 4, "note": "P1.L1 → QS1.1" },
    { "a": 1, "b": 5, "note": "P1.L2 → QS1.3" },
    { "a": 2, "b": 6, "note": "P1.L3 → QS1.5" },
    { "a": 7, "b": 10, "note": "QS1.2 → FU1.1" },
    { "a": 8, "b": 12, "note": "QS1.4 → FU2.1" },
    { "a": 9, "b": 14, "note": "QS1.6 → FU3.1" },
    { "a": 11, "b": 16, "note": "FU1.2 → FR1.1" },
    { "a": 13, "b": 18, "note": "FU2.2 → FR1.3" },
    { "a": 15, "b": 20, "note": "FU3.2 → FR1.5" },
    { "a": 17, "b": 28, "note": "FR1.2 → KM1.1" },
    { "a": 19, "b": 30, "note": "FR1.4 → KM1.3" },
    { "a": 21, "b": 32, "note": "FR1.6 → KM1.5" },
    { "a": 29, "b": 38, "note": "KM1.2 → M1.U1" },
    { "a": 31, "b": 39, "note": "KM1.4 → M1.V1" },
    { "a": 33, "b": 40, "note": "KM1.6 → M1.W1" },
    { "a": 41, "b": 42, "note": "M1.U2 → M1.V2（星点）" },
    { "a": 42, "b": 43, "note": "M1.V2 → M1.W2（星点）" },
    { "a": 3, "b": 44, "note": "P1.N → PE1（接地参考，删掉它必报 E_NO_REFERENCE）" },
    { "a": 0, "b": 45, "note": "P1.L1 → FU4.1（控制回路取电）" },
    { "a": 46, "b": 49, "note": "FU4.2 → SB1.1" },
    { "a": 50, "b": 57, "note": "SB1.2 → SB3.1（两处停止串联）" },
    { "a": 58, "b": 55, "note": "SB3.2 → SB2.3（节点 X）" },
    { "a": 58, "b": 63, "note": "SB3.2 → SB4.3（节点 X）" },
    { "a": 58, "b": 34, "note": "SB3.2 → KM1.13（自锁一端）" },
    { "a": 56, "b": 22, "note": "SB2.4 → FR1.95（节点 Y）" },
    { "a": 64, "b": 22, "note": "SB4.4 → FR1.95（节点 Y）" },
    { "a": 35, "b": 22, "note": "KM1.14 → FR1.95（自锁另一端）" },
    { "a": 23, "b": 26, "note": "FR1.96 → KM1.A1" },
    { "a": 27, "b": 47, "note": "KM1.A2 → FU5.1" },
    { "a": 48, "b": 1, "note": "FU5.2 → P1.L2" }
  ],

  "cases": [
    {
      "name": "初始：两条启动支路都断开",
      "expect_code": "OK",
      "expect": {
        "M1:0": { "i_rms": 0.0, "tol_abs": 0.001 },
        "M1:1": { "i_rms": 0.0, "tol_abs": 0.001 },
        "M1:2": { "i_rms": 0.0, "tol_abs": 0.001 },
        "KM1:0": { "v_rms": 219.39, "v_tol": 0.01, "i_rms": 0.0, "tol_abs": 0.0001 }
      },
      "expect_devices": { "KM1": { "coil_i_rms": 0.0, "tol_abs": 0.001 } }
    },
    {
      "name": "地点1按下SB2：电机 5.02 A，线圈 26.35 mA",
      "set": { "SB2": { "state_bits": 2, "flags": 1 } },
      "expect_code": "OK",
      "expect": {
        "M1:0": { "i_rms": 5.0156, "tol": 0.01, "v_rms": 219.5, "v_tol": 0.01 },
        "M1:1": { "i_rms": 5.0156, "tol": 0.01 },
        "M1:2": { "i_rms": 5.0156, "tol": 0.01 }
      },
      "expect_devices": { "KM1": { "coil_i_rms": 0.026348, "tol": 0.02 } }
    },
    {
      "name": "松开SB2：靠KM13-14自锁，电流保持",
      "set": { "SB2": { "state_bits": 0, "flags": 1 }, "KM1": { "state_bits": 15, "flags": 0 } },
      "expect_code": "OK",
      "expect": { "M1:0": { "i_rms": 5.0156, "tol": 0.01 } },
      "expect_devices": { "KM1": { "coil_i_rms": 0.026348, "tol": 0.02 } }
    },
    {
      "name": "地点2按下SB3（停止）：全断",
      "set": { "SB3": { "state_bits": 0, "flags": 1 }, "KM1": { "state_bits": 15, "flags": 0 } },
      "expect_code": "OK",
      "expect": { "M1:0": { "i_rms": 0.0, "tol_abs": 0.001 } },
      "expect_devices": { "KM1": { "coil_i_rms": 0.0, "tol_abs": 0.001 } }
    },
    {
      "name": "地点2按下SB4（启动）：同样能启动",
      "set": { "SB4": { "state_bits": 2, "flags": 1 } },
      "expect_code": "OK",
      "expect": { "M1:0": { "i_rms": 5.0156, "tol": 0.01 } }
    },
    {
      "name": "反例：删掉 N→PE 这根线（严格模式）",
      "drop_wires": [17],
      "expect_code": "E_NO_REFERENCE"
    },
    {
      "name": "反例：L1 与 L2 导线直连（短路）",
      "add_wires": [[0, 1]],
      "expect_code": "E_SHORT_CIRCUIT"
    }
  ]
}
