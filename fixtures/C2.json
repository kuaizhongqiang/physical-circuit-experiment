  ],

  "wires": [
    { "a": 0, "b": 4, "note": "P1.L1 → FR1.1" },
    { "a": 1, "b": 6, "note": "P1.L2 → FR1.3" },
    { "a": 2, "b": 8, "note": "P1.L3 → FR1.5" },
