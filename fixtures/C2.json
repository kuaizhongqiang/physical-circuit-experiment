    { "a": 7, "b": 26, "note": "FR1.4 → KM1.3" },
    { "a": 9, "b": 28, "note": "FR1.6 → KM1.5" },
    { "a": 25, "b": 34, "note": "KM1.2 → M1.U1" },
    { "a": 27, "b": 35, "note": "KM1.4 → M1.V1" },
    { "a": 29, "b": 36, "note": "KM1.6 → M1.W1" },
    { "a": 37, "b": 38, "note": "星点 U2-V2" },
    { "a": 38, "b": 39, "note": "星点 V2-W2" },
    { "a": 3, "b": 40, "note": "P1.N → PE1" },
    { "a": 0, "b": 10, "note": "P1.L1 → FR1.95" },
    { "a": 11, "b": 14, "note": "FR1.96 → SB1.1" },
