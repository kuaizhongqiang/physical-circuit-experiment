  "cases": [
    {
      "name": "按启动后松开：自锁维持 5.02 A",
      "set": { "SB2": { "state_bits": 0, "flags": 1 }, "KM1": { "state_bits": 15, "flags": 0 } },
      "expect": { "M1:0": { "i_rms": 5.0156, "tol": 0.01 } },
      "expect_devices": { "KM1": { "coil_i_rms": 0.026348, "tol": 0.02 } }
    },
    {
      "name": "按停止 SB1：全断",
      "set": { "SB1": { "state_bits": 0, "flags": 1 }, "KM1": { "state_bits": 15, "flags": 0 } },
      "expect": { "M1:0": { "i_rms": 0.0, "tol_abs": 0.001 } },
      "expect_devices": { "KM1": { "coil_i_rms": 0.0, "tol_abs": 0.0001 } }
